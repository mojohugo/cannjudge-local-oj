[Unit]
Description=CannJudge Local OJ web API and MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cannjudge_web
Group=cannjudge_web
WorkingDirectory=/opt/cannjudge-service
Environment=OJ_STATE_DIR=/opt/cannjudge-service/var
Environment=PYTHONUTF8=1
Environment=CANNJUDGE_BROWSER_STATE_DIR=/opt/cannjudge-service/var/official-browser
ExecStart=/opt/cannjudge-service/.venv/bin/python -m uvicorn oj.app:create_app --factory --host 127.0.0.1 --port 8765 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
